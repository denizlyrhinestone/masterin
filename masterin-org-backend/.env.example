# MasterIn.org Backend Environment Variables Example
# Copy this file to .env and fill in your actual values.
# Do NOT commit your .env file to version control.

# Server Configuration
PORT=3001

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=masterin_db
DB_PORT=5432
# Alternatively, you can use a single DATABASE_URL if your pg Pool setup supports it,
# but current (db/database.js) uses individual variables above.
# DATABASE_URL="postgresql://your_db_user:your_db_password@localhost:5432/masterin_db"

# JSON Web Token (JWT) Configuration
# IMPORTANT: Use a strong, random string (at least 32 characters long)
JWT_SECRET=your_jwt_secret_here_at_least_32_chars_long_and_random

#-----------------------------------------------------------------------
# AWS Configuration (for S3 file uploads and SES email)
#-----------------------------------------------------------------------
# Ensure these are set in your actual .env file for development,
# or configured via your hosting provider's environment variable settings for production.
# For production on AWS, consider using IAM roles for EC2/ECS/Lambda for better security.

AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=your_aws_s3_bucket_region # e.g., us-east-1, eu-west-2

# S3 Specific
S3_BUCKET_NAME=your_unique_s3_bucket_name_for_file_uploads
# Optional: If using an S3-compatible service (like MinIO, DigitalOcean Spaces, LocalStack)
# S3_ENDPOINT_URL=https://your-s3-compatible-endpoint.com
# S3_FORCE_PATH_STYLE=false # Set to true for some S3-compatibles like MinIO

# SES Specific (will be used later in Email Service Integration)
# SES_FROM_EMAIL=your-verified-email@example.com # Email address verified with AWS SES


#-----------------------------------------------------------------------
# AI Service API Keys
#-----------------------------------------------------------------------
# Each key is for a different AI model provider used for specific features.
# Only configure the keys for the services you intend to use.

# DeepSeek API (Used for Lesson Plan Generator, Lab Designer)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Qwen (Alibaba Cloud DashScope) API (Used for Quiz Generator, Math Problem Creator)
QWEN_API_KEY=your_qwen_api_key_here

# Grok (X AI) API (Used for Lesson Text Block Generator)
# Ensure you have access and replace with your actual key if using Grok.
GROK_API_KEY=your_grok_api_key_here

# Optional Grok API Configuration (Defaults are provided in aiToolsRoutes.js if these are not set)
# GROK_API_URL=https://api.xai.com/v1/chat/completions
# GROK_MODEL=grok-1
# GROK_MAX_TOKENS=1000
# GROK_TEMPERATURE=0.7

# Note: Some AI service endpoints (like Qwen's) might be hardcoded in the routes if not made configurable here.
# Review aiToolsRoutes.js for specific model names and API endpoints if you need to change them.
